    <!-- Diva Desktop y Pantallas externas -->
    <string name="diva_desktop_category_title">Diva Desktop (PC y Transmisión)</string>
    <string name="diva_desktop_enable_title">Activar Modo Escritorio</string>
    <string name="diva_desktop_enable_summary_on">Servidor de escritorio activo en puerto 7272. Listo para conectar desde la PC.</string>
    <string name="diva_desktop_enable_summary_off">Inicia el motor de streaming de escritorio para control desde PC (USB o Wi-Fi).</string>
    <string name="diva_desktop_trackpad_title">Trackpad virtual</string>
    <string name="diva_desktop_trackpad_summary">Usa la pantalla del teléfono como ratón y teclado para la PC.</string>
    <string name="diva_desktop_instructions_title">Conexión e información de estado</string>
    <string name="diva_desktop_instructions_summary">Ejecuta «python diva-desktop-client.py» en tu PC (o usa reenvío de puertos ADB: adb forward tcp:7272 tcp:7272).</string>
    <string name="diva_desktop_status_running">● Servidor ACTIVO (Puerto 7272)\n• USB: adb forward tcp:7272 tcp:7272\n• Wi-Fi: %1$s\nToca para ver detalles y comandos.</string>
    <string name="diva_desktop_status_stopped">Servidor inactivo. Activa el modo escritorio arriba para ver la IP y comandos de conexión.</string>
    <string name="diva_desktop_no_wifi">Wi-Fi no conectado</string>
    <string name="diva_desktop_dialog_title">Cómo conectar tu PC a Diva Desktop</string>
    <string name="diva_desktop_dialog_message">🖥️ Modo Escritorio en tu PC\n\n1. Conexión por cable USB (Mínima latencia - Recomendada):\n• Activa «Depuración USB» en Opciones de desarrollador.\n• Conecta el cable USB a la PC.\n• En la consola o terminal de tu PC ejecuta:\n  %2$s\n• Abre tu cliente apuntando a localhost:7272.\n\n2. Conexión por red Wi-Fi (Sin cables):\n• Asegúrate de que la PC y el teléfono estén en la misma red Wi-Fi.\n• Conéctate a:\n  %1$s\n\n3. Cliente de escritorio:\n• Puedes ejecutar «python diva-desktop-client.py» o el cliente compilado «diva-desktop-client».</string>
    <string name="diva_desktop_copy_adb">Copiar comando ADB</string>
    <string name="diva_desktop_adb_copied">Comando ADB copiado al portapapeles</string>
    <string name="diva_desktop_external_title">Pantallas cableadas (DisplayPort / HDMI)</string>
    <string name="diva_desktop_force_desktop_title">Forzar modo escritorio en pantalla externa</string>
    <string name="diva_desktop_force_desktop_summary">Habilita interfaz de ventanas estilo escritorio en monitores conectados físicamente por cable.</string>
    <string name="external_display_settings_summary">Modo escritorio, Diva Desktop y pantallas conectadas</string>

