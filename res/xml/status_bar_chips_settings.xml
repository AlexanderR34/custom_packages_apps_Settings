<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="status_bar_chips_settings_screen"
    android:title="@string/status_bar_chips_settings_title">

    <!-- 1. Configuración General -->
    <PreferenceCategory
        android:key="status_bar_chips_general_category"
        android:title="@string/status_bar_chips_general_category">

        <!-- Límite de chips simultáneos -->
        <ListPreference
            android:key="status_bar_chips_limit"
            android:title="@string/status_bar_chips_limit_title"
            android:summary="@string/status_bar_chips_limit_summary"
            android:entries="@array/status_bar_chips_limit_entries"
            android:entryValues="@array/status_bar_chips_limit_values"
            android:defaultValue="2"
            settings:controller="com.android.settings.system.ChipsLimitPreferenceController" />

        <!-- Estilo al haber múltiples actividades -->
        <ListPreference
            android:key="status_bar_chips_multi_style"
            android:title="@string/status_bar_chips_multi_style_title"
            android:summary="@string/status_bar_chips_multi_style_summary"
            android:entries="@array/status_bar_chips_multi_style_entries"
            android:entryValues="@array/status_bar_chips_multi_style_values"
            android:defaultValue="0"
            settings:controller="com.android.settings.system.ChipsMultiStylePreferenceController" />

        <!-- Estilo de la carátula de música -->
        <ListPreference
            android:key="status_bar_chips_media_art_style"
            android:title="@string/status_bar_chips_media_art_style_title"
            android:summary="@string/status_bar_chips_media_art_style_summary"
            android:entries="@array/status_bar_chips_media_art_style_entries"
            android:entryValues="@array/status_bar_chips_media_art_style_values"
            android:defaultValue="0"
            settings:controller="com.android.settings.system.ChipsMediaArtStylePreferenceController" />

        <!-- Adaptar a Monet / Colores dinámicos -->
        <SwitchPreferenceCompat
            android:key="status_bar_chips_monet_colors"
            android:title="@string/status_bar_chips_monet_title"
            android:summary="@string/status_bar_chips_monet_summary"
            android:defaultValue="false"
            settings:controller="com.android.settings.system.ChipsMonetPreferenceController" />

        <!-- Iconos adaptados a Monet -->
        <SwitchPreferenceCompat
            android:key="status_bar_chips_monet_icons"
            android:title="@string/status_bar_chips_monet_icons_title"
            android:summary="@string/status_bar_chips_monet_icons_summary"
            android:defaultValue="false"
            settings:controller="com.android.settings.system.ChipsMonetIconsPreferenceController" />

    </PreferenceCategory>

    <!-- 2. Chips de actividad visibles -->
    <PreferenceCategory
        android:key="status_bar_chips_visible_category"
        android:title="@string/status_bar_chips_visible_category">

        <!-- Avisos de Privacidad (Cámara / Mic / GPS) -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_privacy"
            android:title="@string/status_bar_chip_enable_privacy_title"
            android:summary="@string/status_bar_chip_enable_privacy_summary"
            android:icon="@drawable/ic_privacy"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Batería de accesorios Bluetooth -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_bluetooth"
            android:title="@string/status_bar_chip_enable_bluetooth_title"
            android:summary="@string/status_bar_chip_enable_bluetooth_summary"
            android:icon="@drawable/ic_settings_bluetooth"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Isla de música y multimedia -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_media"
            android:title="@string/status_bar_chip_enable_media_title"
            android:summary="@string/status_bar_chip_enable_media_summary"
            android:icon="@drawable/ic_media_output"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Progreso de descargas -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_download"
            android:title="@string/status_bar_chip_enable_download_title"
            android:summary="@string/status_bar_chip_enable_download_summary"
            android:icon="@drawable/ic_download_for_offline"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Llamada telefónica en curso -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_call"
            android:title="@string/status_bar_chip_enable_call_title"
            android:summary="@string/status_bar_chip_enable_call_summary"
            android:icon="@drawable/ic_phone"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Temporizadores y alarmas -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_timer"
            android:title="@string/status_bar_chip_enable_timer_title"
            android:summary="@string/status_bar_chip_enable_timer_summary"
            android:icon="@drawable/ic_timelapse"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Navegación en vivo (Mapas / GPS) -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_navigation"
            android:title="@string/status_bar_chip_enable_navigation_title"
            android:summary="@string/status_bar_chip_enable_navigation_summary"
            android:icon="@drawable/ic_settings_location"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Grabación de pantalla -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_screen_record"
            android:title="@string/status_bar_chip_enable_screen_record_title"
            android:summary="@string/status_bar_chip_enable_screen_record_summary"
            android:icon="@drawable/ic_settings_camera"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Compartir pantalla con aplicaciones -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_share_to_app"
            android:title="@string/status_bar_chip_enable_share_to_app_title"
            android:summary="@string/status_bar_chip_enable_share_to_app_summary"
            android:icon="@drawable/ic_share"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Transmitir pantalla a otros dispositivos (Cast) -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_cast"
            android:title="@string/status_bar_chip_enable_cast_title"
            android:summary="@string/status_bar_chip_enable_cast_summary"
            android:icon="@drawable/ic_cast_24dp"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Punto de acceso / Zona Wi-Fi -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_hotspot"
            android:title="@string/status_bar_chip_enable_hotspot_title"
            android:summary="@string/status_bar_chip_enable_hotspot_summary"
            android:icon="@drawable/ic_hotspot"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

        <!-- Notificaciones de actividades de apps -->
        <SwitchPreferenceCompat
            android:key="status_bar_chip_enable_notifs"
            android:title="@string/status_bar_chip_enable_notifs_title"
            android:summary="@string/status_bar_chip_enable_notifs_summary"
            android:icon="@drawable/ic_notifications"
            android:defaultValue="true"
            settings:controller="com.android.settings.system.ChipTogglePreferenceController" />

    </PreferenceCategory>

    <!-- 3. Tiempos de inactividad -->
    <PreferenceCategory
        android:key="status_bar_chips_timeouts_category"
        android:title="@string/status_bar_chips_timeouts_category">

        <!-- Tiempo de espera por inactividad de música -->
        <ListPreference
            android:key="status_bar_chips_media_timeout"
            android:title="@string/status_bar_chips_media_timeout_title"
            android:summary="@string/status_bar_chips_media_timeout_summary"
            android:entries="@array/status_bar_chips_media_timeout_entries"
            android:entryValues="@array/status_bar_chips_media_timeout_values"
            android:defaultValue="30"
            settings:controller="com.android.settings.system.ChipsMediaTimeoutPreferenceController" />

        <!-- Tiempo de visibilidad de avisos de Privacidad -->
        <ListPreference
            android:key="status_bar_chips_privacy_timeout"
            android:title="@string/status_bar_chips_privacy_timeout_title"
            android:summary="@string/status_bar_chips_privacy_timeout_summary"
            android:entries="@array/status_bar_chips_privacy_timeout_entries"
            android:entryValues="@array/status_bar_chips_privacy_timeout_values"
            android:defaultValue="15"
            settings:controller="com.android.settings.system.ChipsPrivacyTimeoutPreferenceController" />

    </PreferenceCategory>

    <!-- 4. Colores de indicadores de hardware (HEX) -->
    <PreferenceCategory
        android:key="status_bar_chips_colors_category"
        android:title="@string/status_bar_chips_colors_category">

        <!-- Color Cámara / Micrófono -->
        <EditTextPreference
            android:key="status_bar_chips_color_cam_mic"
            android:title="@string/status_bar_chips_color_cam_mic_title"
            android:summary="@string/status_bar_chips_color_cam_mic_summary"
            android:dialogTitle="@string/status_bar_chips_color_cam_mic_title"
            android:defaultValue="#00E676"
            settings:controller="com.android.settings.system.ChipsColorCamMicPreferenceController" />

        <!-- Color Ubicación (GPS) -->
        <EditTextPreference
            android:key="status_bar_chips_color_location"
            android:title="@string/status_bar_chips_color_location_title"
            android:summary="@string/status_bar_chips_color_location_summary"
            android:dialogTitle="@string/status_bar_chips_color_location_title"
            android:defaultValue="#0091EA"
            settings:controller="com.android.settings.system.ChipsColorLocationPreferenceController" />

        <!-- Color Cámara/Mic + Ubicación -->
        <EditTextPreference
            android:key="status_bar_chips_color_combo"
            android:title="@string/status_bar_chips_color_combo_title"
            android:summary="@string/status_bar_chips_color_combo_summary"
            android:dialogTitle="@string/status_bar_chips_color_combo_title"
            android:defaultValue="#00F5D4"
            settings:controller="com.android.settings.system.ChipsColorComboPreferenceController" />

        <!-- Color Todos los sensores activos -->
        <EditTextPreference
            android:key="status_bar_chips_color_all"
            android:title="@string/status_bar_chips_color_all_title"
            android:summary="@string/status_bar_chips_color_all_summary"
            android:dialogTitle="@string/status_bar_chips_color_all_title"
            android:defaultValue="#FFB300"
            settings:controller="com.android.settings.system.ChipsColorAllPreferenceController" />

        <!-- Restablecer colores predeterminados -->
        <Preference
            android:key="status_bar_chips_colors_reset"
            android:title="@string/status_bar_chips_colors_reset_title"
            android:summary="@string/status_bar_chips_colors_reset_summary"
            android:icon="@drawable/ic_restore"
            settings:controller="com.android.settings.system.ChipsColorsResetPreferenceController" />

    </PreferenceCategory>

</PreferenceScreen>
