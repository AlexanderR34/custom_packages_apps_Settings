<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="status_bar_chips_sub_settings_screen"
    android:title="@string/status_bar_chips_sub_settings_title">

    <PreferenceCategory
        android:key="status_bar_camera_cutout_category"
        android:title="@string/status_bar_camera_cutout_category">

        <!-- 1. Encender o apagar -->
        <SwitchPreferenceCompat
            android:key="status_bar_draw_camera_cutout"
            android:title="@string/status_bar_draw_camera_cutout_title"
            android:summary="@string/status_bar_draw_camera_cutout_summary"
            android:defaultValue="false"
            settings:controller="com.android.settings.system.CameraCutoutPreferenceController" />

        <!-- 2. Estilo de dibujo (Relleno vs Solo anillo/contorno) -->
        <ListPreference
            android:key="status_bar_camera_cutout_style"
            android:title="@string/status_bar_camera_cutout_style_title"
            android:summary="@string/status_bar_camera_cutout_style_summary"
            android:entries="@array/status_bar_camera_cutout_style_entries"
            android:entryValues="@array/status_bar_camera_cutout_style_values"
            android:defaultValue="0"
            settings:controller="com.android.settings.system.CameraCutoutStylePreferenceController" />

        <!-- 3. Color configurable (HEX) -->
        <EditTextPreference
            android:key="status_bar_camera_cutout_color"
            android:title="@string/status_bar_camera_cutout_color_title"
            android:summary="@string/status_bar_camera_cutout_color_summary"
            android:dialogTitle="@string/status_bar_camera_cutout_color_title"
            android:defaultValue="#000000"
            settings:controller="com.android.settings.system.CameraCutoutColorPreferenceController" />

        <!-- 4. Largo horizontal (Ancho / Width) -->
        <com.android.settingslib.widget.SliderPreference
            android:key="status_bar_camera_cutout_width"
            android:title="@string/status_bar_camera_cutout_width_title"
            settings:controller="com.android.settings.system.CameraCutoutWidthPreferenceController" />

        <!-- 5. Largo vertical (Alto / Height) -->
        <com.android.settingslib.widget.SliderPreference
            android:key="status_bar_camera_cutout_height"
            android:title="@string/status_bar_camera_cutout_height_title"
            settings:controller="com.android.settings.system.CameraCutoutHeightPreferenceController" />

        <!-- 6. Desplazamiento horizontal (Calibración X) -->
        <com.android.settingslib.widget.SliderPreference
            android:key="status_bar_camera_cutout_offset_x"
            android:title="@string/status_bar_camera_cutout_offset_x_title"
            settings:controller="com.android.settings.system.CameraCutoutOffsetXPreferenceController" />

        <!-- 7. Desplazamiento vertical (Calibración Y) -->
        <com.android.settingslib.widget.SliderPreference
            android:key="status_bar_camera_cutout_offset_y"
            android:title="@string/status_bar_camera_cutout_offset_y_title"
            settings:controller="com.android.settings.system.CameraCutoutOffsetYPreferenceController" />

        <!-- 7. Restablecer valores predeterminados -->
        <Preference
            android:key="status_bar_camera_cutout_reset"
            android:title="@string/status_bar_camera_cutout_reset_title"
            android:summary="@string/status_bar_camera_cutout_reset_summary"
            android:icon="@drawable/ic_restore"
            settings:controller="com.android.settings.system.CameraCutoutResetPreferenceController" />

    </PreferenceCategory>

</PreferenceScreen>
