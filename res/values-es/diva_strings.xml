    <!-- Configuración de resolución de pantalla -->
    <string name="custom_screen_resolution_title">Resolución de pantalla</string>
    <string name="custom_screen_resolution_summary">Cambia la resolución a tu gusto. Una menor resolución ahorra batería.</string>
    <string name="custom_screen_resolution_headline">Imágenes más nítidas o más suaves, tú decides</string>
    <string name="custom_screen_resolution_warning">Algunas aplicaciones en ejecución podrían cerrarse al cambiar la resolución.</string>
    <string name="custom_screen_resolution_footer_hint">Una resolución baja aumenta la duración de pantalla, mientras que una mayor resolución puede reducirla.</string>
    <string name="custom_screen_resolution_apply">Aplicar</string>
    <string name="custom_screen_resolution_applied_toast">Resolución de pantalla actualizada correctamente</string>
    
    <string name="custom_screen_resolution_720p">1600x720 HD+</string>
    <string name="custom_screen_resolution_1080p">2400x1080 FHD+</string>
    <string name="custom_screen_resolution_1220p">2712x1220 FHD+ (Nativa)</string>
    <string name="custom_screen_resolution_1440p">3200x1440 QHD+ (Experimental)</string>

    <string name="custom_screen_resolution_desc_720p">HD+ (1600 × 720) • Menor resolución para maximizar el ahorro de batería y fluidez en juegos. Los detalles visuales se verán más suaves.</string>
    <string name="custom_screen_resolution_desc_1080p">FHD+ (2400 × 1080) • Excelente equilibrio entre nitidez y duración de batería en el uso diario.</string>
    <string name="custom_screen_resolution_desc_stock">FHD+ Nativa (2712 × 1220) • Resolución nativa del panel de fábrica con máxima nitidez y calibración original.</string>
    <string name="custom_screen_resolution_desc_1440p">QHD+ (3200 × 1440) • Máxima nitidez ultra detallada (experimental). Mayor consumo de batería.</string>

