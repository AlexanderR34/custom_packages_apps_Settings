    <!-- Fondo de pantalla elástico de gelatina -->
    <string name="jelly_wallpaper_title">Fondo de pantalla elástico</string>
    <string name="jelly_wallpaper_summary">Física elástica de gelatina al tocar el fondo estático</string>
    <string name="jelly_wallpaper_main_switch_title">Usar fondo elástico</string>
    <string name="jelly_wallpaper_top_intro">Convierte cualquier fondo estático en una superficie elástica de tipo gelatina que se deforma y rebota al interactuar con el dedo.</string>
    <string name="jelly_wallpaper_target_title">Aplicar en</string>
