    <!-- Jelly Elastic Wallpaper -->
    <string name="jelly_wallpaper_title">Elastic wallpaper</string>
    <string name="jelly_wallpaper_summary">Tactile soft-body jelly physics on static wallpaper</string>
    <string name="jelly_wallpaper_main_switch_title">Use elastic wallpaper</string>
    <string name="jelly_wallpaper_top_intro">Transforms any static wallpaper into an interactive elastic jelly surface that dynamically deforms and bounces to touch.</string>
    <string name="jelly_wallpaper_target_title">Apply on</string>
    <string name="jelly_wallpaper_footer">The wallpaper smoothly deforms when dragging your finger and oscillates with natural spring-mass physics before settling back to its rest position. Suspends rendering at rest for 0% GPU usage.</string>

    <string name="jelly_wallpaper_aspect_ratio_warning_title">Resolution &amp; Aspect Ratio Notice</string>
    <string name="jelly_wallpaper_aspect_ratio_warning_summary">The system automatically scales and fits images to the panel resolution (1220 × 2712 px at 20:9). If in rare cases you experience unexpected cropping or distortion with non-standard images, you can manually crop the wallpaper to a 20:9 aspect ratio for optimal elastic physics.</string>

